# Server Port configuration
PORT=3000

# Google Gemini API key (Required for campaigns generation)
# Replace with your actual Gemini API Key
GOOGLE_API_KEY=your_gemini_api_key_here

# Meta/Facebook Ad Integrations Credentials
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_ACCESS_TOKEN=your_meta_system_user_access_token_here
META_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback
META_AD_ACCOUNT_ID=your_meta_ad_account_id_here

# Google Ads API Integrations Credentials
# Replace with your actual Google Ads developer and client credentials
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token_here
GOOGLE_ADS_CLIENT_ID=your_google_ads_client_id_here
GOOGLE_ADS_CLIENT_SECRET=your_google_ads_client_secret_here
GOOGLE_ADS_REFRESH_TOKEN=your_google_ads_refresh_token_here
GOOGLE_ADS_CUSTOMER_ID=your_google_ads_customer_id_here
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your_google_ads_login_customer_id_here_if_using_manager_account


